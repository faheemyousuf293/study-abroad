# Copy to .env and adjust.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/studyportal

# Any long random string. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-long-random-string

NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Used only by `pnpm seed` to create the first admin user.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-now

# Production only, on a fresh empty database: run committed migrations at startup.
# RUN_MIGRATIONS=true
